# copy this file to .env.local and fill it in.
# .env.local never gets committed. on vercel the same names go in
# project settings > environment variables instead

# where the database is. while building: the mongodb that runs on this computer
# (this is also the default when the line is missing). for atlas: the connection
# string from atlas > connect > drivers, see docs/atlas-setup.md
MONGODB_URI=mongodb://127.0.0.1:27017

# the database inside it. the app creates every collection and index itself
MONGODB_DB=gryc-portal

# the day the demo treats as "today". the 2026 program ended in august, so the
# demo opens in the middle of week 5. set it to real to use today's date in new york
DEMO_TODAY=2026-08-05

# load the demo data the first time the app finds an empty database.
# set to false once real data goes in
DEMO_AUTOSEED=true
